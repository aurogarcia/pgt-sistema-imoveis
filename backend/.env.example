# Configurações da Aplicação
PORT=3001
NODE_ENV=development

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/pgt_database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pgt_database
DB_USER=username
DB_PASSWORD=password

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRATION=7d

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=2000

# APIs Externas
SIGEF_API_URL=https://sigef.incra.gov.br/
SNCR_API_URL=https://sncr.serpro.gov.br/
CAR_API_URL=https://www.car.gov.br/
CAFIR_API_URL=https://www3.receitafederal.gov.br/

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
EMAIL_FROM=Sistema PGT <noreply@pgt-system.com>

# Upload de Arquivos
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Logs
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Criptografia adicional
CRYPTO_SECRET_KEY=your_crypto_secret_for_sensitive_data

# LGPD
DATA_RETENTION_DAYS=2555
CONSENT_REQUIRED=true